# Generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=

# Generate with: openssl rand -base64 32
GARAGE_ADMIN_TOKEN=

# WebUI login: run htpasswd -nBC 10 admin (prompts for a password).
# In a local .env file, single-quote the entire output to preserve bcrypt's $ signs.
# In Dokploy's environment editor, set the same value and verify $ signs are preserved.
GARAGE_WEBUI_AUTH=

# Optional: protect the /metrics endpoint
GARAGE_METRICS_TOKEN=

# HDD mount paths (must be mounted and owned by root before starting the container)
# Default values match the fstab mounts from the setup guide
GARAGE_DATA_DIR=/mnt/garage/data
GARAGE_META_DIR=/mnt/garage/meta
